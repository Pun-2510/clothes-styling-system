# Generated ML artefacts
project/runs/**

# Local datasets and generated catalog/embedding files. Keep source code and
# documentation in Git; download or regenerate these runtime artifacts locally.
project/data/**
!project/data/.gitkeep
!project/data/README.md
project/embeddings/**
!project/embeddings/.gitkeep
!project/embeddings/README.md
project/embeddings_finetuned/**
!project/embeddings_finetuned/.gitkeep
!project/embeddings_finetuned/README.md
# Seed-specific catalog embeddings are reproducible experiment artifacts.
# Keep every generated file local, including the lightweight *.npy.json metadata.
project/embeddings_diverse_seed_*/**
# Project-local validation caches and trial tables are regenerated offline.
# Keep only the final lightweight project/retrieval_weights.json in Git.
project/validation/**
!project/validation/.gitkeep
!project/validation/README.md
experiments/model_comparison/results/**
!experiments/model_comparison/results/.gitkeep
experiments/model_comparison/cache/**
project/datasets/**
!project/datasets/.gitkeep
!project/datasets/README.md

