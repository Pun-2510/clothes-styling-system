.venv/
frontend/
tests/
logs/
__pycache__/
**/__pycache__/
*.py[cod]

# The backend image needs only the processed catalog, not the source images.
data/*
!data/processed/
data/processed/*
!data/processed/products.csv

# The baseline embeddings are no longer used by the serving configuration.
embeddings/

# Include only the checkpoint served by the backend image.
runs/*
!runs/clip_finetune_3epochs_local/
runs/clip_finetune_3epochs_local/*
!runs/clip_finetune_3epochs_local/best/
!runs/clip_finetune_3epochs_local/best/**
