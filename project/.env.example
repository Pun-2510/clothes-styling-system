# Copy this file to .env after the matching artifacts are available.
# Both backend instances read the same catalog, checkpoint and weights.

# Current recommended deployment: diverse sampling, seed 42.
FASHION_CATALOG_DIR=./data/processed_diverse
FASHION_IMAGE_DIR=./data/data
FASHION_EMBEDDINGS_DIR=./embeddings_diverse_seed_42
FASHION_CHECKPOINT_DIR=./runs/clip_finetune_diverse_seed_42/best
FASHION_RETRIEVAL_WEIGHTS_FILE=../experiments/model_comparison/results/diverse_seed_42/retrieval_weights.json

# Default used by prepare_dataset.py for a newly prepared catalog.
# This value is an offline preparation setting, not a container setting.
MIN_PRODUCTS_PER_CATEGORY=25

# Category confidence used by the running website.
# Fusion and maximum category-bonus weights are read from the JSON above.
CATEGORY_CONFIDENCE_FLOOR=0.50
CATEGORY_CONFIDENCE_THRESHOLD=0.60
CATEGORY_TOP_PER_CLASS=3
