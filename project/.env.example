# Copy this file to .env after the matching project-local artifacts are ready.
# Paths are relative to project/docker-compose.yml; the repository folder may
# have any name. Both backend instances read the same artifact set.
FASHION_CATALOG_DIR=./data/processed
FASHION_IMAGE_DIR=./data/data
FASHION_EMBEDDINGS_DIR=./embeddings
FASHION_CHECKPOINT_DIR=./runs/clip_finetune/best
FASHION_RETRIEVAL_WEIGHTS_FILE=./retrieval_weights.json

# Default used by prepare_dataset.py for a newly prepared catalog.
# This value is an offline preparation setting, not a container setting.
MIN_PRODUCTS_PER_CATEGORY=25

# Category confidence used by the running website.
# Fusion and maximum category-bonus weights are read from the JSON above.
CATEGORY_CONFIDENCE_FLOOR=0.50
CATEGORY_CONFIDENCE_THRESHOLD=0.60
CATEGORY_TOP_PER_CLASS=3
CATEGORY_PROTOTYPE_WEIGHT=1.0
