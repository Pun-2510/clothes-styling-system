# Optional local configuration: copy to .env and choose your prepared artifacts.
# .env is ignored by Git. Both backend instances use these same paths.
FASHION_CATALOG_DIR=./data/processed
FASHION_EMBEDDINGS_DIR=./embeddings
FASHION_CHECKPOINT_DIR=./runs/clip_finetune_3epochs_local/best
FASHION_IMAGE_DIR=./data/data

# Category-confidence thresholds are fixed serving settings. Fusion weights
# are selected on the validation split and saved automatically to
# retrieval_weights.json by tune_serving_weights.py.
CATEGORY_CONFIDENCE_FLOOR=0.50
CATEGORY_CONFIDENCE_THRESHOLD=0.60

# Optional standalone Polyvore outfit-recommendation prototype.
POLYVORE_DATA_DIR=./datasets/polyvore-outfits
OUTFIT_ARTIFACT_DIR=./outfit_recommendation/artifacts
OUTFIT_CLIP_MODEL=openai/clip-vit-base-patch32
